# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# Which LLM backend to use: ollama (local, free) or gemini (API, costs money)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Local Weaviate (start with: docker compose up -d)
WEAVIATE_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-key-here
LANGSMITH_PROJECT=multi-source-agentic-rag
